# Google Service Account JSON key (paste the entire JSON here)
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'

# Google Spreadsheet ID (from the URL: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit)
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# NextAuth
NEXTAUTH_SECRET=generate_random_secret_here
NEXTAUTH_URL=http://localhost:3000

NEXT_PUBLIC_SCHOOL_NAME=""
NEXT_PUBLIC_SCHOOL_LOGO=""

# Push notification (web-push / VAPID). Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NOTIFY_CONTACT_EMAIL=admin@sekolah.id

# Shared secret untuk memproteksi /api/remind (sama dengan GitHub Actions secret CRON_SECRET)
CRON_SECRET=generate_random_secret_here
